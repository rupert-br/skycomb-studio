# Copy this file to .env (gitignored) and fill in your own token.
# Get a public token (starts with "pk.") from https://account.mapbox.com/access-tokens/
# — the default public token on that page works fine, no special scopes needed.
NUXT_PUBLIC_MAPBOX_TOKEN=pk.your_token_here

# Optional overrides (server-only); defaults match app/server/utils/peaks.ts
# NUXT_OVERPASS_URL=https://overpass-api.de/api/interpreter
# NUXT_NOMINATIM_URL=https://nominatim.openstreetmap.org/search
